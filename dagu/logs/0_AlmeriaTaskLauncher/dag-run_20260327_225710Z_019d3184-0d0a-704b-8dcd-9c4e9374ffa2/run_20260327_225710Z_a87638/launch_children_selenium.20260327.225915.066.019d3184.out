      {'id': 'afd13086', 'show': 1, 'in_city': 1, 'one_day': 1,
      'wrong_date_time': 0, 'event': 'Profesor Poopsnuggle', 'slug':
      'profesor-poopsnuggle', 'category': '__NOT_DEFINIED__', 'id_venue':
      'NmPqTrh6', 'venue': 'Berlin Social Club', 'std_venue': 'Berlin Social
      Club', 'start_date': '2026-04-24', 'start_time': '21:30:00', 'end_date':
      '2026-04-24', 'end_time': '23:00:00', 'description': 'Profesor Popsnuggle
      llega a la Sala Berlin Social Club en Almería el 24 de abril de 2026 para
      ofrecer una noche de pop retrofuturista. Germán, José, Álvaro y
      Laureano forman este cuarteto que se inspira en el pop español de los
      años sesenta, la movida madrileña, los sintetizadores analógicos y la
      bossa nova. Desde su irrupción en 2004 con el álbum “El Turismo”, su
      música ha prestado una mirada divertida y crítica al pasado musical
      español. En 2008 reafirmaron su propuesta con el lanzamiento de “El Fin
      de las Colonias Africanas”. Una cita imperdible para los amantes del pop
      con sabor nostálgico y visionario.', 'others': {'category':
      '__NOT_FOUND__', 'hour': '__NOT_FOUND__', 'startDate':
      '2026-4-24T21:30+2:00', 'endDate': '2026-4-24T23:00+2:00',
      'duration_days': 0, 'location': 'Parque de Nicolás Salmerón, 9, Bajo 2,
      04001 Almería'}, 'source': 'AlmeriaTurismo', 'exec_time':
      '20260327T230025', 'session': '2026_03_27_22_57_Viernes', 'image':
      'https://www.turismodealmeria.org/wp-content/uploads/2026/02/profesorpopnu
      ggle.jpg', 'url':
      'https://www.turismodealmeria.org/evento/profesor-poopsnuggle/'}
