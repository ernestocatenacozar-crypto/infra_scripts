{'id': '67def857', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'La Última Folclórica', 'slug': 'la-ultima-folclorica', 'category': 'conciertos', 'id_venue': '27qNP7DH', 'venue': 'Auditorio Maestro Padilla', 'std_venue': 'Auditorio Municipal Maestro Padilla', 'start_date': '2026-04-18', 'start_time': '20:30:00', 'end_date': '2026-04-18', 'end_time': '__NOT_DEFINIED__', 'description': '\n“La Última Folclórica” es un viaje por la historia de la copla y su evolución, desde sus raíces más puras hasta su adaptación a los nuevos tiempos. Laura Gallego recuerda las voces de artistas como Rocío Jurado, Marifé de Triana o Concha Piquer. ', 'others': {'category': 'Flamenco', 'price': '42-45', 'place_url': 'https://conciertos.club/almeria/locales/auditorio-maestro-padilla', 'town': 'Almería'}, 'source': 'ConciertosClub', 'exec_time': '20260224T191112', 'session': '2026_02_24_19_07_Martes', 'image': 'https://conciertos.club/doc/a/2026/a_lauragallego.jpg', 'url': 'https://conciertos.club/almeria/conciertos/113438-la-ultima-folclorica-laura-gallego'}
