{'id': 'cbdab2a9', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'Taller De Escritura Creativa "Emoción en El Escritor, Emoción en El Lector"', 'slug': 'taller-de-escritura-creativa-emocion-en-el-escritor-emocion-en-el-lector', 'category': '__NOT_DEFINIED__', 'id_venue': '8g4nLPqF', 'venue': 'Universidad de Almería (UAL)', 'std_venue': 'Paraninfo de la Universidad de Almería', 'start_date': '2026-04-28', 'start_time': '16:00:00', 'end_date': '2026-04-28', 'end_time': '18:00:00', 'description': 'Descubre los secretos para atrapar a tus lectores y asombrar a los editores. Bruno Nievas nos guiará en este emocionante taller donde aprenderemos a crear ideas poderosas, superar el reto del primer borrador, desarrollar personajes conmovedores, idear situaciones impactantes, incorporar el viaje del héroe, editar sin piedad, publicar y autopublicar, y vender con éxito: ¿comprarías tu propio libro?', 'others': {'category': '__NOT_FOUND__', 'hour': '__NOT_FOUND__', 'startDate': '2026-4-28T16:00+2:00', 'endDate': '2026-4-28T18:00+2:00', 'duration_days': 0, 'location': 'Carr. Sacramento, s/n, 04120 La Cañada, Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260328T211806', 'session': '2026_03_28_21_15_Sabado', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/03/taller-escritura.jpg', 'url': 'https://www.turismodealmeria.org/evento/taller-de-escritura-creativa-emocion-en-el-escritor-emocion-en-el-lector/'}
