{'id': '1f0a91f2', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'Actualidad Astronómica Con Jorge Iglesias', 'slug': 'actualidad-astronomica-con-jorge-iglesias', 'category': '__NOT_DEFINIED__', 'id_venue': None, 'venue': 'Universidad de Almería (UAL)', 'std_venue': None, 'start_date': '2026-02-19', 'start_time': '12:00:00', 'end_date': '2026-02-19', 'end_time': '14:00:00', 'description': 'El ciclo de tertulias sobre astronomía vuelve este año con Jorge Iglesias, quien presentará y debatirá sobre las novedades más importantes en el ámbito astronómico. Las sesiones se llevarán a cabo en el Edificio de Psicología, Sala de Grados, a las 12:00h. Fechas: 19 de febrero, 19 de marzo, 23 de abril y 21 de mayo.', 'others': {'category': 'Edificio de Psicología, Sala de Grados, Universidad de Almería', 'hour': '__NOT_FOUND__', 'startDate': '2026-2-19T12:00+2:00', 'endDate': '2026-2-19T14:00+2:00', 'duration_days': 0, 'location': 'Carr. Sacramento, s/n, 04120 La Cañada, Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260224T183758', 'session': '2026_02_24_18_31_Martes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/02/Actualidad-astronomica-con-Jorge-Iglesias.jpg', 'url': 'https://www.turismodealmeria.org/evento/actualidad-astronomica-con-jorge-iglesias/'}
