{'id': '542b069d', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'Soy Otra Persona, Tal Vez Más Feliz Que Yo: Cuentistas Vivas Y Muertas', 'slug': 'soy-otra-persona-tal-vez-mas-feliz-que-yo-cuentistas-vivas-y-muertas', 'category': '__NOT_DEFINIED__', 'id_venue': 'Q6b6LRjT', 'venue': 'Clasijazz', 'std_venue': 'Clasijazz', 'start_date': '2026-03-19', 'start_time': '21:00:00', 'end_date': '2026-03-19', 'end_time': '23:00:00', 'description': 'Disfruta de una velada de música y literatura dirigida por Isabel G. Caro en la Sala Principal de Clasijazz.', 'others': {'category': 'Música y Literatura', 'hour': '__NOT_FOUND__', 'startDate': '2026-3-19T21:00+2:00', 'endDate': '2026-3-19T23:00+2:00', 'duration_days': 0, 'location': 'C. Maestro Serrano, 9, 04004 Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260224T183758', 'session': '2026_02_24_18_31_Martes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/02/Soy-otra-persona-tal-vez-mas-feliz-que-yo-cuentistas-vivas-y-muertas.jpg', 'url': 'https://www.turismodealmeria.org/evento/soy-otra-persona-tal-vez-mas-feliz-que-yo-cuentistas-vivas-y-muertas-2/'}
