{'id': 'f25e9c5f', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'Certamen Infantil Almería 2026', 'slug': 'certamen-infantil-almeria-2026', 'category': '__NOT_DEFINIED__', 'id_venue': None, 'venue': 'Almería', 'std_venue': None, 'start_date': '2026-02-01', 'start_time': '16:00:00', 'end_date': '2026-02-01', 'end_time': '18:00:00', 'description': 'El próximo domingo 1 de febrero a las 16:00h se celebrará el Certamen Infantil Almería 2026. Un evento lleno de color, alegría y talento infantil con la participación de agrupaciones de chirigotas, parodias y comparsas. Entre las agrupaciones destacadas se encuentran ‘Los guerreros de las galaxias’, ‘Los cocos’ y ‘Las locas’. No te pierdas una tarde de carnaval llena de diversión para toda la familia.', 'others': {'category': 'Domingo 1 de febrero a las 16:00h', 'hour': '__NOT_FOUND__', 'startDate': '2026-2-1T16:00+2:00', 'endDate': '2026-2-1T18:00+2:00', 'duration_days': 0, 'location': 'Calle Tarragona 2'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260224T183758', 'session': '2026_02_24_18_31_Martes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/01/Certamen-Infantil-Almeria-2026.jpg', 'url': 'https://www.turismodealmeria.org/evento/certamen-infantil-almeria-2026/'}
