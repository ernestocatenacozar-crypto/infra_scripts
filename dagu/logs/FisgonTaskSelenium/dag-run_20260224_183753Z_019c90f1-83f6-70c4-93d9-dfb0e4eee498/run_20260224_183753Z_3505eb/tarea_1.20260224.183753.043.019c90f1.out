{'id': '615b29de', 'show': 1, 'in_city': 1, 'one_day': 0, 'wrong_date_time': 0, 'event': 'Escultura Abstracta Metal - Judith Vegas', 'slug': 'escultura-abstracta-metal-judith-vegas', 'category': '__NOT_DEFINIED__', 'id_venue': '8g4nLPqF', 'venue': 'Paraninfo de la Universidad de Almería', 'std_venue': 'Paraninfo de la Universidad de Almería', 'start_date': '2026-02-24', 'start_time': '10:00:00', 'end_date': '2026-03-25', 'end_time': '10:00:00', 'description': 'La artista Judith Vegas presenta su exposición ‘Escultura Abstracta Metal’ en el Paraninfo de la Universidad de Almería. Esta muestra de artes plásticas reúne esculturas contemporáneas trabajadas en metal, explorando formas orgánicas y geométricas en un lenguaje abstracto. La exposición estará abierta al público desde el 24 de febrero hasta el 25 de marzo de 2026 en la sala de exposiciones.', 'others': {'category': 'Paraninfo - Sala de exposiciones, Universidad de Almería', 'hour': '__NOT_FOUND__', 'startDate': '2026-2-24T10:00+2:00', 'endDate': '2026-3-25T10:00+2:00', 'duration_days': 29, 'location': 'Paraninfo de la Universidad de Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260224T183758', 'session': '2026_02_24_18_31_Martes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/02/Escultura-Abstracta-Metal-Judith-Vegas.jpg', 'url': 'https://www.turismodealmeria.org/evento/escultura-abstracta-metal-judith-vegas/'}
