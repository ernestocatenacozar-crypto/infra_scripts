{'id': 'bb6504fa', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'Halloween Forever', 'slug': 'halloween-forever', 'category': '__NOT_DEFINIED__', 'id_venue': 'DgpfFbPt', 'venue': 'Teatro Cervantes', 'std_venue': 'Teatro Cervantes', 'start_date': '2026-03-05', 'start_time': '18:30:00', 'end_date': '2026-03-05', 'end_time': '20:30:00', 'description': 'Prepárate para una noche de risas y escalofríos con ‘Halloween Forever’, un espectáculo teatral único para toda la familia. Disfruta de un desfile de icónicos personajes del terror como Pennywise, Harley Quinn, La Monja y muchos más en una divertida y terrorífica puesta en escena. El evento tendrá lugar en el emblemático Teatro Cervantes de Almería el jueves 5 de marzo a las 18:30 h. Entradas por solo 10 €.', 'others': {'category': 'Teatro Cervantes - Halloween Forever', 'hour': '__NOT_FOUND__', 'startDate': '2026-3-5T18:30+2:00', 'endDate': '2026-3-5T20:30+2:00', 'duration_days': 0, 'location': 'Calle Poeta Villaespesa, 1, 04001 Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260224T183758', 'session': '2026_02_24_18_31_Martes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/02/Halloween-Forever-1.jpg', 'url': 'https://www.turismodealmeria.org/evento/halloween-forever/'}
