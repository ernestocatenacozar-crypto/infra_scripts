{'id': 'c5da0989', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'Daniel Higiénico en Concierto', 'slug': 'daniel-higienico-en-concierto', 'category': '__NOT_DEFINIED__', 'id_venue': 'trpmPB62', 'venue': 'Cervecería el Zaguán', 'std_venue': 'Zaguán', 'start_date': '2026-02-21', 'start_time': '21:30:00', 'end_date': '2026-02-21', 'end_time': '23:30:00', 'description': 'El irreverente y carismático Daniel Higiénico aterriza en Almería con su estilo inconfundible lleno de humor, crítica social y una buena dosis de rock. El evento tendrá lugar en El Zaguán el sábado 21 de febrero a las 21:30 h. No te pierdas una noche única de música en directo en un ambiente íntimo y acogedor.', 'others': {'category': 'El Zaguán, Almería', 'hour': '__NOT_FOUND__', 'startDate': '2026-2-21T21:30+2:00', 'endDate': '2026-2-21T23:30+2:00', 'duration_days': 0, 'location': 'C. San Leonardo, 41 4004, Almería, Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260224T183758', 'session': '2026_02_24_18_31_Martes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/02/Daniel-Higienico-en-concierto.jpg', 'url': 'https://www.turismodealmeria.org/evento/daniel-higienico-en-concierto/'}
