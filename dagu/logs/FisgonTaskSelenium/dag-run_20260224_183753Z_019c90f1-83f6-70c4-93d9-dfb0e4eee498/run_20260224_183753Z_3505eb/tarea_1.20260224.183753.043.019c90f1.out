{'id': '3844f27f', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'Spring Rock Fest Vol.7', 'slug': 'spring-rock-fest-vol-7', 'category': '__NOT_DEFINIED__', 'id_venue': None, 'venue': 'Dragon Fly Rock Café', 'std_venue': None, 'start_date': '2026-02-21', 'start_time': '21:00:00', 'end_date': '2026-02-21', 'end_time': '23:00:00', 'description': 'Llega el festival más potente de la primavera: Spring Rock Fest Vol.7. Una noche cargada del mejor rock en directo con las bandas Sprocket y Trashtorna2, en un evento para mayores de 16 años. El Pub Dragonfly será el escenario perfecto para vibrar con guitarras eléctricas, una atmósfera explosiva y mucha energía. No te lo pierdas este sábado 21 de febrero a partir de las 21:00. Entrada: 5 euros. Entradas disponibles en Logiticket.', 'others': {'category': 'Sábado 21 de febrero en Pub Dragonfly', 'hour': '__NOT_FOUND__', 'startDate': '2026-2-21T21:00+2:00', 'endDate': '2026-2-21T23:00+2:00', 'duration_days': 0, 'location': 'Calle San Juan Bosco 18, Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260224T183758', 'session': '2026_02_24_18_31_Martes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/02/Spring-Rock-Fest-Vol.7.jpg', 'url': 'https://www.turismodealmeria.org/evento/spring-rock-fest-vol-7/'}
