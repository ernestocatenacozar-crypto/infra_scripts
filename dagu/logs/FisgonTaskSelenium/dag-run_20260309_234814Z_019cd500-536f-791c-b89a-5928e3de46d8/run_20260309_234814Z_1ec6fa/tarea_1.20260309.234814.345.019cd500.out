{'id': '7fa07f6f', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'El Mentalista Canalla', 'slug': 'el-mentalista-canalla', 'category': '__NOT_DEFINIED__', 'id_venue': '7qHRF9LM', 'venue': 'Sala EMMA', 'std_venue': 'Sala Escuela Municipal de Música & Artes', 'start_date': '2026-04-24', 'start_time': '20:00:00', 'end_date': '2026-04-24', 'end_time': '22:00:00', 'description': 'No te pierdas el impactante show de Abraham Gallego, ‘El Mentalista Canalla’, un espectáculo de magia y mentalismo para toda la familia. Vive una experiencia divertida y desafiante, donde la magia y la mente se unen para sorprenderte en cada momento. ¡Ven a disfrutarlo el 24 de abril en la Sala EMMA de Almería!', 'others': {'category': 'Abraham Gallego presenta un espectáculo de magia y mentalismo', 'hour': '__NOT_FOUND__', 'startDate': '2026-4-24T20:00+2:00', 'endDate': '2026-4-24T22:00+2:00', 'duration_days': 0, 'location': 'C. Rbla. Obispo Orberá, 23, 04001 Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260309T234819', 'session': '2026_03_09_23_45_Lunes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/02/elmentalista.jpg', 'url': 'https://www.turismodealmeria.org/evento/el-mentalista-canalla/'}
