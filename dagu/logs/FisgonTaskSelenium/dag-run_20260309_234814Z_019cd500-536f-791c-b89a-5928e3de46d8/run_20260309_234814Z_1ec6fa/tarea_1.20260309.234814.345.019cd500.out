{'id': '8c02b3b0', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': "El Selu Presenta 'Universo Cádi'", 'slug': 'el-selu-presenta-universo-cadi', 'category': '__NOT_DEFINIED__', 'id_venue': 'DgpfFbPt', 'venue': 'Teatro Cervantes', 'std_venue': 'Teatro Cervantes', 'start_date': '2026-04-18', 'start_time': '21:30:00', 'end_date': '2026-04-18', 'end_time': '23:30:00', 'description': 'El Selu presenta ‘Universo Cádi’, un espectáculo de la reconocida chirigota de El Selu. Un viaje cómico y musical al particular universo gaditano, lleno de sátira, humor y talento carnavalesco. Una cita imprescindible para los amantes del carnaval y del buen humor, que tendrá lugar el 18 de abril a las 21:30h en el Teatro Cervantes de Almería.', 'others': {'category': 'Teatro Cervantes - 18 de abril a las 21:30h', 'hour': '__NOT_FOUND__', 'startDate': '2026-4-18T21:30+2:00', 'endDate': '2026-4-18T23:30+2:00', 'duration_days': 0, 'location': 'Calle Poeta Villaespesa, 1, 04001 Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260309T234819', 'session': '2026_03_09_23_45_Lunes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/02/Universo-Cadiz-Chirigota-de-El-Selu.jpg', 'url': 'https://www.turismodealmeria.org/evento/el-selu-presenta-universo-cadi/'}
