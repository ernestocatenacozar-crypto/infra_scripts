{'id': 'b944cffb', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'Jam Gumbo – Especial Mardi Gras', 'id_venue': 'Q6b6LRjT', 'venue': 'Clasijazz', 'std_venue': 'Clasijazz', 'start_date': '2026-02-18', 'start_time': '22:00:00', 'end_date': '2026-02-18', 'end_time': '23:59:00', 'description': 'Celebra el Carnaval con estilo en ‘Mardi Gras Django VII’ con una vibrante Jam Gumbo al más puro estilo de Nueva Orleans. Disfruta de una noche llena de música, máscaras y fiesta el miércoles 18 de febrero de 2026 en Clasijazz a partir de las 22:00. ¡No te lo pierdas!', 'others': {'category': 'Jam Gumbo - New Orleans Style', 'hour': '__NOT_FOUND__', 'startDate': '2026-2-18T22:00+2:00', 'endDate': '2026-2-18T23:59+2:00', 'duration_days': 0, 'location': 'C. Maestro Serrano, 9, 04004 Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260203T160223', 'session': '2026_02_03_15_59_Martes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/01/Mardi-Gras-Django-VII.jpg', 'url': 'https://www.turismodealmeria.org/evento/jam-session-especial-mardi-gras/'}
