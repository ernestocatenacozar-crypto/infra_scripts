{'id': '71bc81a2', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'La Casa De Bernarda Alba', 'slug': 'la-casa-de-bernarda-alba', 'category': '__NOT_DEFINIED__', 'id_venue': '7qHRF9LM', 'venue': 'Escuela Municipal de Música y Artes', 'std_venue': 'Sala Escuela Municipal de Música & Artes', 'start_date': '2026-04-10', 'start_time': '20:30:00', 'end_date': '2026-04-10', 'end_time': '22:30:00', 'description': 'Disfruta de la obra ‘La Casa de Bernarda Alba’ en EMMA, Escuela de Música & Artes de Almería, una impresionante representación de la famosa obra de Federico García Lorca. compra las entradas en. compra aquí las entradas', 'others': {'category': 'EMMA, Escuela de Música & Artes, Almería', 'hour': '__NOT_FOUND__', 'startDate': '2026-4-10T20:30+2:00', 'endDate': '2026-4-10T22:30+2:00', 'duration_days': 0, 'location': 'Rambla del Obispo Orbera, 23,04001 Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260406T194525', 'session': '2026_04_06_19_42_Lunes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/03/Captura-de-pantalla-2026-03-30-084618.jpg', 'url': 'https://www.turismodealmeria.org/evento/la-casa-de-bernarda-alba/'}
