{'id': '8121bcb7', 'show': 1, 'in_city': 1, 'one_day': 1, 'wrong_date_time': 0, 'event': 'Pocas Luces - Monólogo De Manolo Lera', 'slug': 'pocas-luces-monologo-de-manolo-lera', 'category': '__NOT_DEFINIED__', 'id_venue': '7qHRF9LM', 'venue': 'Sala EMMA', 'std_venue': 'Sala Escuela Municipal de Música & Artes', 'start_date': '2026-04-11', 'start_time': '20:00:00', 'end_date': '2026-04-11', 'end_time': '22:00:00', 'description': 'Prepárate para una noche de risas con el monólogo ‘Pocas Luces’ de Manolo Lera. El humorista llega a Almería para presentarse en la Sala EMMA de la Escuela Municipal de Música y Artes el próximo 11 de abril de 2026 a las 20:00 h. Un espectáculo donde el ingenio y la ironía se apoderan del escenario. ¡No te lo pierdas! Entrada: 12,00 €.', 'others': {'category': 'Sala EMMA · Escuela Municipal de Música y Artes', 'hour': '__NOT_FOUND__', 'startDate': '2026-4-11T20:00+2:00', 'endDate': '2026-4-11T22:00+2:00', 'duration_days': 0, 'location': 'C. Rbla. Obispo Orberá, 23, 04001 Almería'}, 'source': 'AlmeriaTurismo', 'exec_time': '20260406T194525', 'session': '2026_04_06_19_42_Lunes', 'image': 'https://www.turismodealmeria.org/wp-content/uploads/2026/02/descargar.jpg', 'url': 'https://www.turismodealmeria.org/evento/pocas-luces-monologo-de-manolo-lera/'}
