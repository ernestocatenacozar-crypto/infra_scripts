# Libreria de variables de infraestructura para docker compose y scripts.
# No guardar secretos aqui: los secretos se inyectan con Doppler.

COMPOSE_PROJECT_NAME=orbitando_infra
TZ=Europe/Madrid
WORKSPACE_ROOT=/home/ubuntu
HOST_INFRA_PATH=${WORKSPACE_ROOT}/infra_scripts

# Scraper Setup
HOST_FISGON_PATH=${WORKSPACE_ROOT}/fisgon
FISGON_SCRAPER_IMAGE=fisgon_scraper:latest
SELENIUM_PORT=4444
SELENIUM_VNC_PORT=7900

# Data storage Setup
HOST_DATA_STORAGE_PATH=${WORKSPACE_ROOT}/events_storage/
DATABASE_PATH=${HOST_DATA_STORAGE_PATH}orbitando.sqlite3

# Fronmtend Setup
HOST_FRONTEND_PATH=${WORKSPACE_ROOT}/frontend_build_orbitando
FRONTEND_IMAGE=orbitando_frontend:latest
HOST_FRONTEND_DIST_PATH=${HOST_FRONTEND_PATH}/dist
FRONTEND_BUILD_IMAGE=orbitando_frontend_build:latest
FRONTEND_PORT=5000
CONTAINER_APP_ROOT_FRONTEND=/app
CONTAINER_APP_ROOT_BUILD=/app/dist
CONTAINER_FRONTEND_NODE_MODULES_PATH=/app/node_modules
FRONTEND_NODE_MODULES_VOLUME=orbitando_frontend_node_modules

# Refinement Portal Setup
HOST_REFINEMENT_PORTAL_PATH=${WORKSPACE_ROOT}/refinement_portal/
REFINEMENT_PORTAL_IMAGE=refinement_portal:latest
REFINEMENT_PORTAL_PORT=5002

# Dagu Orchestration Setup
DAGU_IMAGE=infra_scripts-dagu:latest
DAGU_HOST_PORT=3012
DAGU_BASE_URL=http://localhost:3012
########################
#### DAGS VARIABLES ####
########################
# for connect with commit to repo inside DAGs
HOST_SSH_PATH=${HOME}/.ssh
# for the build, url of the web to generate in the build
ORBITA_CITY=almeria
BASE_URL=
# for the build, to upload data to bunny.net
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_PULL_ZONE_ID=
BUNNY_ACCOUNT_API_KEY=
